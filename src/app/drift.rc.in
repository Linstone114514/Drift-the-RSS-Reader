// Windows application resources: exe icon + version info.
// Generated from drift.rc.in by CMake — edit the template, not this file.

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/drift.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L   // VOS_NT_WINDOWS32
 FILETYPE       0x1L       // VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Drift"
            VALUE "FileDescription",  "Drift — RSS Reader"
            VALUE "FileVersion",      "@PROJECT_VERSION@.0"
            VALUE "OriginalFilename", "drift.exe"
            VALUE "ProductName",      "Drift"
            VALUE "ProductVersion",   "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200   // English, Unicode
    END
END
